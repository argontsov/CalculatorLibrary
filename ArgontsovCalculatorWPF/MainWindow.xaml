<Window x:Class="ArgontsovCalculatorWPF.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Argontsov Calculator" Height="350" Width="300" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Первое число:" FontWeight="Bold"/>
            <TextBox x:Name="txtNum1" Height="25" Margin="0,5,0,5"/>

            <TextBlock Text="Второе число / Степень:" FontWeight="Bold"/>
            <TextBox x:Name="txtNum2" Height="25" Margin="0,5,0,5"/>
        </StackPanel>

        <!-- Кнопки операций -->
        <UniformGrid Grid.Row="1" Columns="3" Rows="2" Height="80" Margin="0,0,0,15">
            <Button Content="+" Click="Add_Click" FontSize="18" Margin="2"/>
            <Button Content="-" Click="Subtract_Click" FontSize="18" Margin="2"/>
            <Button Content="*" Click="Multiply_Click" FontSize="18" Margin="2"/>
            <Button Content="/" Click="Divide_Click" FontSize="18" Margin="2"/>
            <Button Content="^" Click="Power_Click" FontSize="18" Margin="2"/>
        </UniformGrid>

        <!-- Результат -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Результат:" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="txtResult" Height="30" FontSize="16" IsReadOnly="True" Background="#FFF0F0F0" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>